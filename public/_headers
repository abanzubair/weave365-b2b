# Cloudflare Pages Custom Headers Configuration
# Global Security Rules for All Routes
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://assets.weave365.com https://drive.google.com https://lh3.googleusercontent.com https://*.googleusercontent.com https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://assets.weave365.com https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://api.resend.com; frame-src 'self' https://ecom-template-1-tau.vercel.app https://50k-gamma.vercel.app; frame-ancestors 'self' https://ecom-template-1-tau.vercel.app https://50k-gamma.vercel.app; object-src 'none'; base-uri 'self'; form-action 'self';
  ! Access-Control-Allow-Origin

# Public / Developer Partner APIs (Scoped CORS)
/api/v1/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-API-Key

/api/developer/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-API-Key

/api/catalog
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization

/api/feed/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type

# Static Bundles (Cache & Font/Asset CDN CORS)
/_next/static/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
