{
  "name": "saree-wholesale-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 --webpack",
    "build": "next build",
    "cloudflare:build": "opennextjs-cloudflare build",
    "start": "next start -H 127.0.0.1",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
