    "next": "^16.2.6",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@opennextjs/cloudflare": "^1.19.11",
    "esbuild": "^0.25.0",
    "wrangler": "^4.93.0"
  }
}
