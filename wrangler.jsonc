{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weave365",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": ".vercel/output/static",
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "weave365images"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
