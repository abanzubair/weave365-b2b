{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weave365",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "weave365images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
